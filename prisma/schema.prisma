generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARENTS
  CHILDREN
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  fullName      String
  username      String    @unique
  role          Role      @default(CHILDREN)
  avatarUrl     String?
  status        UserStatus @default(ACTIVE)
  plan          SubscriptionPlan?
  classCode     String?
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  // Self-relation for parent-child
  parentId      String?
  parent        User?     @relation("ParentChildren", fields: [parentId], references: [id])
  children      User[]    @relation("ParentChildren")

  // Relation to school
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id])

  // Preferences
  notificationsEnabled Boolean @default(true)

  // Assignments
  givenAssignments Assignment[] @relation("Assigner")
  receivedAssignments Assignment[] @relation("Assignee")

  // Activities & Savings
  activities    ActivityHistory[]
  savingGoals   SavingGoal[]

  // Gamification & Progress
  gamification  Gamification?
  userBadges    UserBadge[]

  // Wallet
  walletTransactions WalletTransaction[] @relation("UserWalletTransactions")

  // Stories
  stories       Story[]
}

model School {
  id        String   @id @default(uuid())
  name      String
  address   String?
  teachers  User[]
  createdAt DateTime @default(now())
}

model Gamification {
  id            String @id @default(uuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalPoints   Int    @default(0)
  currentStreak Int    @default(0)
  updatedAt     DateTime         @updatedAt
  
  // Subscription & Gamification
  energy        Int              @default(2) // Free tier gets 2 energy/month
  maxEnergy     Int?             // Limit set by parent/teacher
}

model Badge {
  id          String   @id @default(uuid())
  icon        String
  title       String
  description String
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// Menyimpan struktur cerita AI yang asalnya dari IndexedDB
model Story {
  id          String   @id @default(uuid())
  title       String
  topic       String?
  theme       String?
  pagesData   Json     // Disimpan dalam bentuk JSON array
  isPreset    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}


// ==========================================
// Fitur Pembimbing & Literasi Finansial
// ==========================================

model ActivityHistory {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        String   // "STORY_READ", "QUIZ_COMPLETED", "SAVING_DEPOSIT"
  title       String   // Judul cerita atau aktivitas
  score       Int?     // Skor kuis jika ada
  pointsEarned Int     @default(0) // Poin yang didapatkan dari aktivitas ini
  
  createdAt   DateTime @default(now())
}

model SavingGoal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title         String   // Contoh: "Mainan Dinosaurus"
  targetAmount  Int      // Target tabungan (misal 50000)
  currentAmount Int      @default(0) // Tabungan terkumpul
  isCompleted   Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum AssignmentStatus {
  PENDING
  COMPLETED
}

model Assignment {
  id          String   @id @default(uuid())
  
  assignerId  String
  assigner    User     @relation("Assigner", fields: [assignerId], references: [id], onDelete: Cascade)
  
  assigneeId  String
  assignee    User     @relation("Assignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  topic       String
  theme       String
  status      AssignmentStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TransactionType {
  INCOME
  EXPENSE
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserWalletTransactions", fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Int
  category    String
  description String?
  date        DateTime @default(now())
}
